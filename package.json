    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "link": "react native link",
    "test": "jest",
    "lint": "eslint .",
    "clean": "cd ./android \n ./gradlew clean ",
    "ins": "rm -rf node_modules \n npm i",
    "unsigned": "react-native bundle --dev false --platform android --entry-file index.js --bundle-output ./android/app/src/main/assets/index.android.bundle --assets-dest ./android/app/src/main/res",
    "rmdrawabble": "rm -rf ./android/app/src/main/res/drawable-* \n  rm -rf ./android/app/src/main/res/raw \n rm -rf ./android/openboard/src/main/res/drawable-*",
    "build-ios": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "bundle": "cd android && ./gradlew bundleRelease",
    "debug": "react-native bundle --dev false --platform android --entry-file index.js --bundle-output ./android/app/src/main/assets/index.android.bundle --assets-dest ./android/app/src/main/res \n cd android \n ./gradlew assembleDebug",
    "release": "rm -rf ./android/app/src/main/res/drawable-* \n  rm -rf ./android/app/src/main/res/raw \n cd android \n ./gradlew clean \n ./gradlew assembleRelease",
    "postjpx": "npx jetify",
    "postinstall": "patch-package && node_modules/.bin/rn-nodeify --install crypto --hack",
    "release-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/build/intermediates/res/merged/release/ && rm -rf android/app/src/main/res/drawable-* && rm -rf android/app/src/main/res/raw/* && cd android && ./gradlew assembleRelease && cd .."
  },
