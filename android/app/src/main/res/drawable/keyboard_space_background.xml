<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:id="@+id/space_pressed" android:bottom="135dp" android:left="35dp" android:right="135dp" android:state_pressed="true" android:top="135dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="@dimen/medium_margin" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:id="@+id/space_normal" android:bottom="135dp" android:left="135dp" android:right="135dp" android:state_pressed="true" android:top="135dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="@dimen/small_margin" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
